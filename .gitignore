/target

# Chemin local vers protoc (machine de dev sans apt/sudo), voir
# crates/kvm-device-plugin
/.cargo/config.toml

# Node / Next.js
dashboard/node_modules
dashboard/.next
dashboard/out
dashboard/.env*.local

# donnees/certs generes par l'instance Kanidm de dev
deploy/dev/kanidm/data/

# jeton API Kanidm + env genere par deploy/dev/local-stack.sh (secrets locaux)
deploy/dev/local-stack/env.sh
# jeton ServiceAccount de l'api-server hors cluster (24 h, regenere par le script)
deploy/dev/local-stack/api-server-sa-token

# binaires/images Firecracker de dev (gros fichiers, recuperes via
# deploy/dev/firecracker/fetch-test-assets.sh)
deploy/dev/firecracker/assets/

# binaires envbuilder/crane de dev (gros fichiers)
deploy/dev/envbuilder/envbuilder
deploy/dev/crane/crane

# Certificats et cles generes par la PKI locale de dev
deploy/dev/pki/ca/
deploy/dev/pki/certs/

# GitLab Pages / MkDocs build outputs
public/
site/

# Python (services/pm-engine, Jalon M5)
services/*/.venv/
services/*/__pycache__/
services/*/**/__pycache__/
services/*/*.egg-info/
services/*/.pytest_cache/

# Terraform (deploy/terraform/) : state local, cache providers, valeurs
# reelles par environnement (domaine/zone Cloudflare, etc. - voir
# live/*/terraform.tfvars.example pour les placeholders suivis par git),
# et le backend.hcl genere par bootstrap.sh (nom de bucket/table reels).
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
backend.hcl
# Plans sauvegardes (`terraform plan -out=...`) : binaire pouvant contenir
# des secrets en clair (mots de passe generes, etc.), jamais a committer.
tfplan*

