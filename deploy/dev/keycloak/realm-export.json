{
  "id": "atelier",
  "realm": "atelier",
  "displayName": "Atelier Dev",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role"
      },
      {
        "name": "developer",
        "description": "Developer role"
      }
    ]
  },
  "users": [
    {
      "username": "atelier-admin",
      "email": "admin@atelier.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Atelier",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-not-for-production",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "atelier-test-user",
      "email": "test-user@atelier.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-not-for-production",
          "temporary": false
        }
      ],
      "realmRoles": [
        "developer"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "atelier-dashboard",
      "name": "Atelier Dashboard Next.js",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "http://app.atelier.local:3000/*",
        "http://app.atelier.local/*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-atelier-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "atelier-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "atelier-api",
      "name": "Atelier API Server",
      "enabled": true,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "atelier-pm-bot",
      "name": "Atelier PM Engine (service account)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-only-not-for-production-pm-bot-secret",
      "protocolMappers": [
        {
          "name": "audience-atelier-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "atelier-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}